generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Condition {
  NEW
  REFURBISHED
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

// Fulfilment only. Refunds are a payment state (PaymentStatus), so a refunded order is e.g. CANCELLED + REFUNDED.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

// The source of truth for money: whether the customer has paid and what was given back
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ShippingMethod {
  DELIVERY
  PICKUP
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

// Where a product's installation fee comes from: its category's (the nearest category up the tree with one), its own,
// or no installation at all
enum InstallationOption {
  CATEGORY
  OWN
  NONE
}

// A storefront customer's trade account: a business applies, the platform's staff approve it with a discount
enum TradeAccountStatus {
  PENDING
  APPROVED
  REJECTED
  // Approved once, its discount stopped for now
  SUSPENDED
}

enum BusinessType {
  INSTALLER
  IT_CONTRACTOR
  RESELLER
  OTHER
}

// One installation visit per order, arranged by the platform's staff after payment
enum InstallationStatus {
  TO_ARRANGE
  BOOKED
  DONE
  CANCELLED
}

model AppSettings {
  id                 String  @id @default("singleton")
  storeName          String
  storeDescription   String?
  consoleName        String?
  consoleDescription String?
  logoUrl            String?
  faviconUrl         String?
  // The platform is the seller of record, so one tax rate applies to every order. A fraction: 0.15 is 15%.
  // Shown prices exclude tax: it's added on top at checkout (see Order.taxGhs).
  // Each order copies it (Order.taxRate), so changing it never alters past orders.
  // When taxEnabled is off, orders are charged no tax and copy a taxRate of 0.
  taxEnabled         Boolean @default(false)
  taxRate            Decimal @default(0) @db.Decimal(5, 4)
  // Whether the delivery fee is taxed too
  taxShipping        Boolean @default(false)

  // Staff notifications, emailed to these addresses (not necessarily console users), one switch per event
  notificationEmails        String[] @default([])
  // Orders customers place on the storefront, and orders staff create in a store's workspace
  notifyStorefrontOrders    Boolean  @default(true)
  notifyStaffOrders         Boolean  @default(false)
  // A sale taking a listing (or variant) to its low-stock threshold, or to 0
  notifyLowStock            Boolean  @default(true)
  notifyOutOfStock          Boolean  @default(true)
  // The daily exchange-rate fetch failing (orders stop once the last rate is too old)
  notifyRateFetchFailure    Boolean  @default(true)
  // A store's owner or admin giving a refund (the platform keeps an eye on money going back)
  notifyStoreRefunds        Boolean  @default(true)
  // A customer posting a 1 or 2 star review
  notifyLowRatings          Boolean  @default(false)
  // A business applying for a trade account
  notifyTradeApplications   Boolean  @default(true)
  // A customer making a quotation on the storefront
  notifyQuotes              Boolean  @default(false)
  // Added to the rate fetched each day (0-10), to cover the cedi moving between quoting or pricing and paying.
  // A rate set by hand is used as typed.
  exchangeRateMarkupPercent Decimal  @default(0) @db.Decimal(4, 2)
  // How long a quotation's prices hold, in days
  quoteValidityDays         Int      @default(7)

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  region    String
  town      String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDefault Boolean  @default(false)

  @@map("address")
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String?
  phone              String?
  dob                DateTime? @db.Date
  email              String    @unique
  emailVerified      Boolean   @default(false)
  getMarketingEmails Boolean   @default(true)
  getSecurityEmails  Boolean   @default(true)
  getOrderEmails     Boolean   @default(true)
  image              String?
  role               String    @default("user")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  addresses             Address[]
  cart                  Cart?
  orders                Order[]
  reviews               Review[]
  hiddenReviews         Review[]                   @relation("ReviewHiddenBy")
  wishListItems         WishListItem[]
  tradeAccount          TradeAccount?              @relation("TradeAccountUser")
  quotes                Quote[]                    @relation("QuoteUser")
  // Quotations they made for customers in the console
  createdQuotes         Quote[]                    @relation("QuoteCreatedBy")
  tradeAccountsReviewed TradeAccount[]             @relation("TradeAccountReviewedBy")
  sessions              Session[]
  accounts              Account[]
  members               Member[]
  invitations           Invitation[]
  createdOrders         Order[]                    @relation("OrderCreatedBy")
  // Payments they recorded by hand (cash, mobile money or a card terminal in a store)
  recordedPayments      Order[]                    @relation("OrderPaymentRecordedBy")
  statusChanges         OrderStatusHistory[]
  installationChanges   OrderInstallationHistory[]
  refundsGiven          OrderRefund[]              @relation("OrderRefundedBy")
  returnsRecorded       OrderReturn[]              @relation("OrderReturnRecordedBy")

  purchaseOrdersCreated  PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  purchaseOrdersPlaced   PurchaseOrder[]        @relation("PurchaseOrderOrderedBy")
  purchaseOrdersClosed   PurchaseOrder[]        @relation("PurchaseOrderClosedBy")
  purchaseOrdersReceived PurchaseOrderReceipt[]
  stockMovements         StockMovement[]

  @@map("user")
}

enum ExchangeRateSource {
  MANUAL
  OPEN_EXCHANGE_RATES
}

// Delivery fees are GHS: couriers charge in cedis, so a fee doesn't move with the exchange rate. This row holds what
// applies to every delivery; its updatedAt is the version the Delivery card in Settings saves against (CONFLICT).
model DeliverySettings {
  id                  String   @id @default("singleton")
  // An order whose subtotal after its discount reaches this delivers free; null: never free
  freeDeliveryFromGhs Decimal? @db.Decimal(12, 2)
  updatedAt           DateTime @updatedAt

  @@map("delivery_settings")
}

// The storefront's Terms and Privacy pages, as the platform (the seller of record) writes them in Settings. Rich text
// (TipTap JSON, cleaned by sanitizeRichText); null: no page yet, and nothing links to it. Each *UpdatedAt is when that
// text last changed, shown on its page.
model LegalPages {
  id               String    @id @default("singleton")
  termsOfService   String?
  termsUpdatedAt   DateTime?
  privacyPolicy    String?
  privacyUpdatedAt DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("legal_pages")
}

// A region's delivery fee (town null), or a town's, which overrides its region's. An address in a region with neither
// isn't delivered to. Region and town names are GEODATA's (@workspace/contracts), as addresses store them.
model DeliveryRate {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region String
  town   String?
  feeGhs Decimal @db.Decimal(12, 2)

  // Postgres treats NULLs as distinct, so each region's own fee needs its own partial index
  @@unique([region, town])
  @@unique([region], map: "delivery_rate_region_key", where: { town: null })
  @@map("delivery_rate")
}

// Where the platform's installers work: a whole region (town null) or a town. Unlike delivery there's no fee per area:
// the fee is the product's (Product.installation). Names are GEODATA's, as for DeliveryRate.
model InstallationArea {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region String
  town   String?

  // Postgres treats NULLs as distinct, so a whole region needs its own partial index
  @@unique([region, town])
  @@unique([region], map: "installation_area_region_key", where: { town: null })
  @@map("installation_area")
}

// Only a version: its updatedAt is what the Installation card in Settings saves against (CONFLICT), as the Delivery
// card does with DeliverySettings
model InstallationSettings {
  id        String   @id @default("singleton")
  updatedAt DateTime @updatedAt

  @@map("installation_settings")
}

model ExchangeRate {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from       String // "USD"
  to         String // "GHS"
  // Units of `to` per 1 `from`: for USD→GHS, 15.5 means $1 = GH₵15.50. What prices use: a fetched rate with the
  // markup in Settings added (AppSettings.exchangeRateMarkupPercent), or one set by hand as typed.
  rate       Decimal            @db.Decimal(12, 6)
  // The market rate fetched, before the markup; null for a rate set by hand
  marketRate Decimal?           @db.Decimal(12, 6)
  date       DateTime           @db.Date // the date this rate applies to
  // Where it came from: the daily fetch, or a superAdmin in Settings (which overrides a fetched one)
  source     ExchangeRateSource @default(MANUAL)
  fetchedAt  DateTime           @default(now())
  orders     Order[]
  quotes     Quote[]

  // One rate per currency pair per day. It also serves lookups by pair, so no separate [from, to] index is needed.
  @@unique([from, to, date])
  @@map("exchange_rate")
}

model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  slug        String    @unique
  website     String?
  logo        String?
  description String?
  products    Product[]
  status      Status    @default(DRAFT)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@map("brand")
}

model Category {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String         @unique
  description        String?
  image              String?
  products           Product[]
  // Specifications its products (and those in the categories under it) can have
  specs              CategorySpec[]
  parent             Category?      @relation("CategoriesHierarchy", fields: [parentId], references: [id], onDelete: NoAction)
  parentId           String?        @db.Uuid
  childCategories    Category[]     @relation("CategoriesHierarchy")
  status             Status         @default(DRAFT)
  isFeatured         Boolean        @default(false)
  // Installing one of its products, in GHS (labour is paid in cedis). Categories under it use it unless they set their
  // own; null: none of its own.
  installationFeeGhs Decimal?       @db.Decimal(12, 2)
  // Order among siblings, lowest first. Ties (all 0 until someone reorders) fall back to name order.
  position           Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  // Names are unique among siblings, and the first index also serves lookups by parent. Postgres treats NULLs as
  // distinct, so top-level categories need their own partial index.
  @@unique([parentId, name])
  @@unique([name], map: "category_root_name_key", where: { parentId: null })
  @@map("category")
}

model Product {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  slug    String @unique
  brandId String @db.Uuid
  brand   Brand  @relation(fields: [brandId], references: [id])

  // Base prices in USD - can be overridden by store listings and their variants.
  // All catalogue prices are USD; they're converted to GHS with the day's exchange rate when shown.
  baseSellPrice Decimal @default(0) @db.Decimal(12, 2)
  baseBuyPrice  Decimal @default(0) @db.Decimal(12, 2)

  sku        String?  @unique
  barcode    String?  @unique
  weight     Decimal? @db.Decimal(12, 2)
  dimensions String?

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  status             Status             @default(DRAFT)
  condition          Condition          @default(NEW)
  // Installing one unit: the category's fee, its own (installationFeeGhs, GHS, set only for OWN), or not offered
  installation       InstallationOption @default(CATEGORY)
  installationFeeGhs Decimal?           @db.Decimal(12, 2)
  description        String?
  images             String[] // Main product images
  // Its published reviews' average (0.00-5.00) and count, recomputed by each review change (@workspace/commerce/reviews)
  rating             Decimal            @default(0) @db.Decimal(3, 2)
  numReviews         Int                @default(0)
  banner             String?
  tags               String[]

  // Variant support
  hasVariants    Boolean          @default(false)
  variants       ProductVariant[]
  variantOptions VariantOption[] // e.g., "Size", "Color"

  orderItems    OrderItem[]
  quoteItems    QuoteItem[]
  reviews       Review[]
  wishListItems WishListItem[]
  storeListings StoreListing[]
  documents     ProductDocument[]
  specValues    ProductSpecValue[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@map("product")
}

enum SpecType {
  SELECT // one of the spec's options
  NUMBER // with an optional unit, e.g. 30 m
  BOOLEAN // yes or no
  TEXT
}

// A specification products can have, e.g. CCTV Cameras: Resolution. It applies to products in its category and in every
// category under it, and the storefront can filter by it.
model CategorySpec {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String               @db.Uuid
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  type         SpecType
  unit         String? // NUMBER only, e.g. "m"
  // Order on the product form and among the storefront's filters, lowest first; ties fall back to name order
  position     Int                  @default(0)
  isFilterable Boolean              @default(true)
  options      CategorySpecOption[]
  values       ProductSpecValue[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt

  // The unique index also serves lookups by category
  @@unique([categoryId, name])
  @@map("category_spec")
}

// A SELECT spec's choices. Products point at the row, so renaming one keeps their values.
model CategorySpecOption {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  specId   String             @db.Uuid
  spec     CategorySpec       @relation(fields: [specId], references: [id], onDelete: Cascade)
  value    String
  position Int                @default(0)
  values   ProductSpecValue[]

  @@unique([specId, value])
  @@map("category_spec_option")
}

// A product's value for a spec: one column set, by the spec's type
model ProductSpecValue {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String              @db.Uuid
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  specId       String              @db.Uuid
  spec         CategorySpec        @relation(fields: [specId], references: [id], onDelete: Cascade)
  optionId     String?             @db.Uuid
  option       CategorySpecOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  numberValue  Decimal?            @db.Decimal(14, 4)
  booleanValue Boolean?
  textValue    String?

  // The unique index also serves lookups by product; the others serve the storefront's filters
  @@unique([productId, specId])
  @@index([specId, optionId])
  @@index([specId, numberValue])
  @@index([optionId])
  @@map("product_spec_value")
}

model ProductDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_document")
}

// Defines variant types (e.g., "Size", "Color")
model VariantOption {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String               @db.Uuid
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // e.g., "Size", "Color", "Material"
  position  Int                  @default(0) // Display order
  values    VariantOptionValue[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt

  @@unique([productId, name])
  @@map("variant_option")
}

// Defines specific values (e.g., "Red", "Large", "Cotton")
model VariantOptionValue {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId      String                @db.Uuid
  option        VariantOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value         String // e.g., "Red", "Large", "XL"
  position      Int                   @default(0)
  variantValues ProductVariantValue[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt

  @@unique([optionId, value])
  @@map("variant_option_value")
}

// Individual product variants (e.g., "Red T-Shirt - Size L")
model ProductVariant {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Variant identification
  sku     String  @unique // e.g., "TSHIRT-RED-L"
  barcode String? @unique

  // Variant-specific attributes
  variantValues ProductVariantValue[] // Links to option values (e.g., Color: Red, Size: L)

  // Variant-specific details
  images     String[] // Variant-specific images
  weight     Decimal? @db.Decimal(12, 2) // For shipping
  dimensions String? // e.g., "10x5x3 cm"

  position Int @default(0) // Display order

  // A variant that has been ordered can't be deleted (OrderItem restricts it), so it's archived instead.
  // Defaults to PUBLISHED: the product's own status decides whether any of it is visible.
  status Status @default(PUBLISHED)

  orderItems           OrderItem[]
  quoteItems           QuoteItem[]
  storeListingVariants StoreListingVariant[]
  wishListItems        WishListItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt

  @@index([productId])
  @@map("product_variant")
}

// Junction table linking variants to their option values
model ProductVariantValue {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId     String             @db.Uuid
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String             @db.Uuid
  optionValue   VariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([optionValueId])
  @@map("product_variant_value")
}

model StoreListing {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                @db.Uuid
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId            String                @db.Uuid
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems           OrderItem[]
  quoteItems           QuoteItem[]
  cartItems            CartItem[]
  storeListingVariants StoreListingVariant[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockMovements       StockMovement[]

  trackInventory    Boolean @default(true)
  lowStockThreshold Int     @default(0)

  // Store-specific overrides, in USD
  sellPrice      Decimal  @db.Decimal(12, 2)
  buyPrice       Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  status         Status   @default(DRAFT)
  isFeatured     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The unique index also serves lookups by organizationId
  @@unique([organizationId, productId])
  @@index([productId])
  @@map("store_listing")
}

model StoreListingVariant {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeListingId     String              @db.Uuid
  storeListing       StoreListing        @relation(fields: [storeListingId], references: [id], onDelete: Cascade)
  variantId          String              @db.Uuid
  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Prices in USD. Null falls back to the store listing's price.
  buyPrice           Decimal?            @db.Decimal(12, 2)
  sellPrice          Decimal?            @db.Decimal(12, 2)
  compareAtPrice     Decimal?            @db.Decimal(12, 2) // Original price for discounts
  trackInventory     Boolean             @default(true)
  lowStockThreshold  Int                 @default(0)
  stock              Int                 @default(0)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  quoteItems         QuoteItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]
  status             Status              @default(DRAFT)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([storeListingId, variantId])
  @@index([variantId])
  @@map("store_listing_variant")
}

model Cart {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?    @unique @db.Uuid
  sessionCartId String     @unique
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@map("cart")
}

model CartItem {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId                String               @db.Uuid
  cart                  Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeListingId        String               @db.Uuid
  storeListing          StoreListing         @relation(fields: [storeListingId], references: [id], onDelete: Cascade)
  storeListingVariantId String?              @db.Uuid
  // Cascade, not the optional default SetNull, which would turn a variant in the cart into the plain product
  storeListingVariant   StoreListingVariant? @relation(fields: [storeListingVariantId], references: [id], onDelete: Cascade)
  quantity              Int                  @default(1)
  // Installation of every unit on the line, at the product's fee
  withInstallation      Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt

  // One line per variant. Postgres treats NULLs as distinct, so listings without variants need their own partial index.
  @@unique([cartId, storeListingId, storeListingVariantId])
  @@unique([cartId, storeListingId], map: "cart_item_no_variant_key", where: { storeListingVariantId: null })
  @@index([storeListingId])
  @@index([storeListingVariantId])
  @@map("cart_item")
}

model OrderSequence {
  id    Int @id @default(1)
  value Int @default(0)

  @@map("order_sequence")
}

model Order {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Customer
  userId        String? @db.Uuid
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String? // optional: walk-in POS customers may not give one
  customerPhone String?

  shippingMethod ShippingMethod @default(DELIVERY)

  // Shipping address snapshot
  shippingName   String?
  shippingPhone  String?
  shippingLine1  String?
  shippingLine2  String?
  shippingRegion String?
  shippingTown   String?
  shippingLat    Float?
  shippingLng    Float?

  // Payment
  paymentMethod       PaymentMethod @default(CASH)
  paymentStatus       PaymentStatus @default(PENDING)
  paidAt              DateTime?
  // Who recorded a payment taken by hand (cash, mobile money or a card terminal); null for one paid online
  paymentRecordedById String?       @db.Uuid
  paymentRecordedBy   User?         @relation("OrderPaymentRecordedBy", fields: [paymentRecordedById], references: [id], onDelete: SetNull)

  // Status
  status OrderStatus @default(PENDING)

  // Pricing (USD): the sum of the items' totalPriceUsd
  subtotalUsd Decimal @db.Decimal(12, 2)

  // Pricing (GHS). The customer is charged in GHS.
  // totalGhs = subtotalGhs - discountAmountGhs + shippingGhs + installationGhs + taxGhs
  // Tax is charged after the discount: each item is taxed on totalPriceGhs - discountGhs.
  subtotalGhs       Decimal @db.Decimal(12, 2) // the sum of the items' totalPriceGhs, so the lines on a receipt add up
  shippingGhs       Decimal @db.Decimal(12, 2) // set by staff
  installationGhs   Decimal @default(0) @db.Decimal(12, 2) // the sum of the items' installationTotalGhs
  // The sum of the items' taxGhs and installationTaxGhs, plus shippingGhs * taxRate when AppSettings.taxShipping is on
  taxGhs            Decimal @db.Decimal(12, 2)
  taxRate           Decimal @db.Decimal(5, 4) // AppSettings.taxRate at the time of the order
  // Set when staff change the calculated tax, which should only happen for genuine exceptions
  taxOverrideReason String?
  totalGhs          Decimal @db.Decimal(12, 2)

  discountType      DiscountType?
  discountValue     Decimal?      @db.Decimal(12, 2) // FIXED: a GHS amount. PERCENTAGE: a percentage.
  discountAmountGhs Decimal?      @db.Decimal(12, 2) // the computed GHS amount, split across the items as OrderItem.discountGhs
  discountReason    String?

  // The USD→GHS rate used for this order, copied so the order never changes when rates do.
  // rateSource is the ExchangeRate row it came from; Restrict keeps that row while any order uses it.
  exchangeRate   Decimal       @db.Decimal(12, 6)
  exchangeRateId String?       @db.Uuid
  rateSource     ExchangeRate? @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)

  // Where a storefront order was placed from (the first X-Forwarded-For address), so one visitor can only hold so
  // many unpaid orders (and their stock) at a time. Null for staff orders.
  placedFromIp        String?
  // Placed by an approved trade account: its discount is the order's (discountType PERCENTAGE), and the company's
  // details are copied for the invoice, so later changes to the account don't alter the order
  tradeAccountId      String?                    @db.Uuid
  tradeAccount        TradeAccount?              @relation(fields: [tradeAccountId], references: [id], onDelete: SetNull)
  // The quotation it was placed from, if any
  quote               Quote?
  tradeCompanyName    String?
  tradeTin            String?
  // Null for an order without installation. installationDate is the booked day; installationHistory says who did what.
  installationStatus  InstallationStatus?
  installationDate    DateTime?                  @db.Date
  installationHistory OrderInstallationHistory[]
  // When "Find an order" last emailed this order's link, so its customer can't be sent it over and over
  orderLinkSentAt     DateTime?

  // POS
  createdById String? @db.Uuid
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Reference number
  reference String @unique

  notes           String?
  orderItems      OrderItem[]
  statusHistory   OrderStatusHistory[]
  refunds         OrderRefund[]
  paymentAttempts PaymentAttempt[]
  returns         OrderReturn[]
  stockMovements  StockMovement[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // reference is @unique, which already indexes it
  @@index([userId])
  @@index([createdById])
  @@index([placedFromIp])
  @@index([tradeAccountId])
  @@index([paymentRecordedById])
  @@index([exchangeRateId])
  @@index([status])
  @@map("order")
}

model OrderStatusHistory {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String      @db.Uuid
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?     @db.Uuid
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([changedById])
  @@map("order_status_history")
}

// A storefront customer's quotation: the basket priced as checkout would price it (rate, tax, trade discount,
// installation, delivery to the address), its GHS amounts fixed until validUntil. It holds no stock. Accepting it
// places an order at these amounts (orderId), after checking every line is still on sale and in stock. "Expired" is an
// open quote past validUntil, worked out, not stored.
enum QuoteStatus {
  OPEN
  ACCEPTED
  CANCELLED
}

model Quote {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // QT-20261022-00012, numbered by quote_reference_seq (see its migration)
  reference         String        @unique
  // The account that made it on the storefront. A quote staff made has none: it belongs to whichever account has its
  // email, verified (quoteOwnerWhere in @workspace/commerce/quotes).
  userId            String?       @db.Uuid
  user              User?         @relation("QuoteUser", fields: [userId], references: [id], onDelete: SetNull)
  // The staff member who made it in the console; null for one the customer made from their basket
  createdById       String?       @db.Uuid
  createdBy         User?         @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Printed on the quote for the customer, e.g. lead times; staff-made quotes only
  notes             String?
  // Who it's addressed to, and the delivery the order would make
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingLine1     String
  shippingLine2     String?
  shippingRegion    String
  shippingTown      String
  // Made by an approved trade account: its discount is the quote's, and the company's details are printed on it
  tradeAccountId    String?       @db.Uuid
  tradeAccount      TradeAccount? @relation(fields: [tradeAccountId], references: [id], onDelete: SetNull)
  tradeCompanyName  String?
  tradeTin          String?
  status            QuoteStatus   @default(OPEN)
  validUntil        DateTime
  // The amounts, as Order's: totalGhs = subtotalGhs - discountAmountGhs + shippingGhs + installationGhs + taxGhs
  subtotalUsd       Decimal       @db.Decimal(12, 2)
  subtotalGhs       Decimal       @db.Decimal(12, 2)
  discountType      DiscountType?
  discountValue     Decimal?      @db.Decimal(12, 2)
  discountAmountGhs Decimal?      @db.Decimal(12, 2)
  discountReason    String?
  shippingGhs       Decimal       @db.Decimal(12, 2)
  installationGhs   Decimal       @default(0) @db.Decimal(12, 2)
  taxRate           Decimal       @db.Decimal(5, 4)
  taxGhs            Decimal       @db.Decimal(12, 2)
  totalGhs          Decimal       @db.Decimal(12, 2)
  // The rate it was priced at; Restrict keeps the row, and its rate can't change while a quote uses it (RATE_IN_USE)
  exchangeRate      Decimal       @db.Decimal(12, 6)
  exchangeRateId    String?       @db.Uuid
  rateSource        ExchangeRate? @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  // The order accepting it placed
  orderId           String?       @unique @db.Uuid
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items             QuoteItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([createdById])
  @@index([status])
  @@index([tradeAccountId])
  @@index([exchangeRateId])
  @@map("quote")
}

// A quoted line, with OrderItem's amounts and snapshot. Its links are cleared (SetNull), not refused, when a listing,
// variant, product or store is deleted: a quote mustn't stop that. Accepting it then finds the line unavailable.
model QuoteItem {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId               String               @db.Uuid
  quote                 Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  organizationId        String?              @db.Uuid
  organization          Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  storeListingId        String?              @db.Uuid
  storeListing          StoreListing?        @relation(fields: [storeListingId], references: [id], onDelete: SetNull)
  storeListingVariantId String?              @db.Uuid
  storeListingVariant   StoreListingVariant? @relation(fields: [storeListingVariantId], references: [id], onDelete: SetNull)
  productId             String?              @db.Uuid
  product               Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId      String?              @db.Uuid
  productVariant        ProductVariant?      @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  // Quoted by variant: a variant that's gone since leaves the line unavailable, rather than the plain product
  hasVariant            Boolean
  quantity              Int
  unitPriceUsd          Decimal              @db.Decimal(12, 2)
  totalPriceUsd         Decimal              @db.Decimal(12, 2)
  unitPriceGhs          Decimal              @db.Decimal(12, 2)
  totalPriceGhs         Decimal              @db.Decimal(12, 2)
  discountGhs           Decimal              @default(0) @db.Decimal(12, 2)
  taxGhs                Decimal              @db.Decimal(12, 2)
  installationUnitGhs   Decimal?             @db.Decimal(12, 2)
  installationTotalGhs  Decimal              @default(0) @db.Decimal(12, 2)
  installationTaxGhs    Decimal              @default(0) @db.Decimal(12, 2)
  productName           String
  productSlug           String
  productImage          String?
  variantDescription    String?
  sku                   String?
  storeName             String

  @@index([quoteId])
  @@index([organizationId])
  @@index([storeListingId])
  @@index([storeListingVariantId])
  @@index([productId])
  @@index([productVariantId])
  @@map("quote_item")
}

// One per customer account. Approving sets discountPercent, which every order the account places afterwards gets as
// its discount (a percentage, before tax). A rejection's reason is shown to the customer, who can apply again.
model TradeAccount {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @db.Uuid
  user               User               @relation("TradeAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  registrationNumber String
  // The Ghana Revenue Authority's taxpayer number, printed on the account's invoices
  tin                String
  phone              String
  businessType       BusinessType
  // What the business does and buys, in the applicant's words
  details            String?
  status             TradeAccountStatus @default(PENDING)
  // 0.01-99.99, set while approved or suspended
  discountPercent    Decimal?           @db.Decimal(5, 2)
  rejectionReason    String?
  reviewedById       String?            @db.Uuid
  reviewedBy         User?              @relation("TradeAccountReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  orders             Order[]
  quotes             Quote[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([reviewedById])
  @@map("trade_account")
}

// Each change to an order's installation: arranged, booked (or moved) for a day, done, or cancelled
model OrderInstallationHistory {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String             @db.Uuid
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      InstallationStatus
  date        DateTime?          @db.Date
  // Told to the customer with a booking, e.g. "The installer will call the day before"
  note        String?
  changedById String?            @db.Uuid
  changedBy   User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())

  @@index([orderId])
  @@index([changedById])
  @@map("order_installation_history")
}

enum PaymentAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

// One go at paying a storefront order online through Paystack. Paystack takes each reference once, so every "Pay now"
// is a new attempt; a success on any of them pays the order, and a second success (paid twice, or after the order was
// cancelled for going unpaid) is kept here for staff to refund. Written by @workspace/commerce/online-payments.
model PaymentAttempt {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String               @db.Uuid
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Sent to Paystack: the order's reference and a random suffix
  reference       String               @unique
  // What Paystack was asked to take: the order's totalGhs when the attempt began
  amountGhs       Decimal              @db.Decimal(12, 2)
  status          PaymentAttemptStatus @default(PENDING)
  // Paystack's channel once paid: card, mobile_money, ...
  channel         String?
  // Paystack's own message, e.g. "Approved" or "Declined"
  gatewayResponse String?
  paidAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([orderId])
  @@map("payment_attempt")
}

// Money given back on a paid order, by the platform. An order can have several (partial refunds); their sum never
// exceeds Order.totalGhs, and Order.paymentStatus follows it (PARTIALLY_REFUNDED, then REFUNDED).
model OrderRefund {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String        @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountGhs    Decimal       @db.Decimal(12, 2)
  // How the money went back, which needn't be how it was paid
  method       PaymentMethod
  reason       String
  refundedById String?       @db.Uuid
  refundedBy   User?         @relation("OrderRefundedBy", fields: [refundedById], references: [id], onDelete: SetNull)
  // Set when the money went back for returned items
  return       OrderReturn?
  createdAt    DateTime      @default(now())

  @@index([orderId])
  @@index([refundedById])
  @@map("order_refund")
}

// Items a customer brought back after the order reached them, recorded by the platform. The order's status stays as it
// was (it was fulfilled); the money, if any goes back, is an OrderRefund of its own, linked here, and shipping isn't
// refunded. A line's returned quantities never add up to more than it sold, which the return code checks with the
// order row locked.
model OrderReturn {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String            @db.Uuid
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason         String
  refundId       String?           @unique @db.Uuid
  refund         OrderRefund?      @relation(fields: [refundId], references: [id], onDelete: SetNull)
  recordedById   String?           @db.Uuid
  recordedBy     User?             @relation("OrderReturnRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  items          OrderReturnItem[]
  stockMovements StockMovement[]
  createdAt      DateTime          @default(now())

  @@index([orderId])
  @@index([recordedById])
  @@map("order_return")
}

model OrderReturnItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId    String      @db.Uuid
  return      OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String      @db.Uuid
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  // Whether these units went back into the listing's stock: a faulty item doesn't
  restocked   Boolean

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("order_return_item")
}

model OrderItem {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  storeListingId String       @db.Uuid
  storeListing   StoreListing @relation(fields: [storeListingId], references: [id], onDelete: Restrict)

  storeListingVariantId String?              @db.Uuid
  storeListingVariant   StoreListingVariant? @relation(fields: [storeListingVariantId], references: [id], onDelete: Restrict)

  quantity    Int
  // Whether the sale took stock off its listing (or variant), which tracked it then. A cancellation or a restocking
  // return puts back what was taken, whatever the row tracks by then.
  tracksStock Boolean

  // Prices in USD, and in GHS at the order's exchange rate. Each GHS amount is rounded once, here,
  // and Order.subtotalGhs is their sum.
  unitPriceUsd  Decimal @db.Decimal(12, 2)
  totalPriceUsd Decimal @db.Decimal(12, 2)
  unitPriceGhs  Decimal @db.Decimal(12, 2)
  totalPriceGhs Decimal @db.Decimal(12, 2)
  // This item's share of the order discount, in proportion to totalPriceGhs. The rounding remainder goes on
  // the last item, so the shares add up to Order.discountAmountGhs exactly.
  discountGhs   Decimal @default(0) @db.Decimal(12, 2)
  // (totalPriceGhs - discountGhs) * Order.taxRate, rounded once
  taxGhs        Decimal @db.Decimal(12, 2)

  // Installation of every unit, in GHS: the product's fee per unit (null: not installed), times the quantity, and its
  // tax at Order.taxRate, rounded once. The order's discount doesn't apply to it.
  installationUnitGhs  Decimal? @db.Decimal(12, 2)
  installationTotalGhs Decimal  @default(0) @db.Decimal(12, 2)
  installationTaxGhs   Decimal  @default(0) @db.Decimal(12, 2)

  // Snapshot
  productName        String
  productSlug        String
  productImage       String?
  variantDescription String?
  sku                String?
  storeName          String
  // Restrict like the links above: anything that has been ordered is archived, never deleted.
  // The snapshot fields keep what was sold at the time, so later renames and price changes don't rewrite orders.
  product            Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId          String?         @db.Uuid
  productVariant     ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  productVariantId   String?         @db.Uuid

  returns OrderReturnItem[]
  reviews Review[]

  @@index([orderId])
  @@index([organizationId])
  @@index([storeListingId])
  @@index([storeListingVariantId])
  @@index([productId])
  @@index([productVariantId])
  @@map("order_item")
}

// ============================================
// PURCHASING
// ============================================

// Who a store buys its stock from. Each store keeps its own. One that has been used on a purchase order is archived,
// never deleted, so the order keeps its supplier.
model Supplier {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  isArchived     Boolean         @default(false)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Also serves lookups by organizationId
  @@unique([organizationId, name])
  @@map("supplier")
}

// DRAFT changes nothing. ORDERED makes the lines' remaining quantities incoming stock, and receiving them adds them to
// stock (PARTIALLY_RECEIVED, then RECEIVED). CLOSED ends a partly received order whose rest isn't coming; CANCELLED
// ends one before anything arrived.
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum Currency {
  USD
  GHS
}

// A store's order of stock from a supplier. Costs are in the supplier's currency, as invoiced; each line also keeps its
// cost in USD (the catalogue's currency), which is what a listing's buy price is set to when the goods are received.
model PurchaseOrder {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The store whose order it is. Restrict: a store that has had stock bought in is suspended, never deleted
  // (beforeDeleteOrganization says so first).
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // A supplier that has been used can't be deleted, only archived
  supplierId     String              @db.Uuid
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  // PO-20261019-00001, numbered by a sequence (see its migration)
  reference      String              @unique
  status         PurchaseOrderStatus @default(DRAFT)

  currency     Currency
  // USD→GHS (GHS per 1 USD), copied from the day's rate when costs in GHS were converted to USD; null for USD
  exchangeRate Decimal? @db.Decimal(12, 6)
  // In the order's currency. Shown in its totals; it isn't spread over the lines' costs.
  shippingCost Decimal  @default(0) @db.Decimal(12, 2)

  // The day the supplier said it would arrive
  expectedOn DateTime? @db.Date
  notes      String?

  createdById String?   @db.Uuid
  createdBy   User?     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orderedAt   DateTime?
  orderedById String?   @db.Uuid
  orderedBy   User?     @relation("PurchaseOrderOrderedBy", fields: [orderedById], references: [id], onDelete: SetNull)
  // When it was closed or cancelled, by whom and why
  closedAt    DateTime?
  closedById  String?   @db.Uuid
  closedBy    User?     @relation("PurchaseOrderClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closeReason String?

  items     PurchaseOrderItem[]
  receipts  PurchaseOrderReceipt[]
  createdAt DateTime               @default(now())
  // The version an edit form loaded: a save from a stale form is refused
  updatedAt DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([supplierId])
  @@index([createdById])
  @@index([orderedById])
  @@index([closedById])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // Restrict like OrderItem: a listing (or variant) that has been bought in is archived, never deleted, and so is the
  // store (beforeDeleteOrganization refuses a store with purchase orders)
  storeListingId        String               @db.Uuid
  storeListing          StoreListing         @relation(fields: [storeListingId], references: [id], onDelete: Restrict)
  storeListingVariantId String?              @db.Uuid
  storeListingVariant   StoreListingVariant? @relation(fields: [storeListingVariantId], references: [id], onDelete: Restrict)

  // Snapshot, refreshed whenever a draft is saved
  productName        String
  variantDescription String?
  sku                String?

  quantityOrdered  Int
  // Kept up by each receipt (the sum of its PurchaseOrderReceiptItem rows), never more than ordered
  quantityReceived Int     @default(0)
  // In the order's currency, as invoiced
  unitCost         Decimal @db.Decimal(12, 2)
  // The same cost in USD: unitCost itself for an order in USD, else unitCost / exchangeRate, rounded once
  unitCostUsd      Decimal @db.Decimal(12, 2)
  position         Int     @default(0)

  receipts PurchaseOrderReceiptItem[]

  @@index([purchaseOrderId])
  @@index([storeListingId])
  @@index([storeListingVariantId])
  @@map("purchase_order_item")
}

// One delivery: what came in, who checked it in, and whether the listings' buy prices were set to these costs
model PurchaseOrderReceipt {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId  String                     @db.Uuid
  purchaseOrder    PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedById     String?                    @db.Uuid
  receivedBy       User?                      @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  note             String?
  updatedBuyPrices Boolean
  items            PurchaseOrderReceiptItem[]
  stockMovements   StockMovement[]
  createdAt        DateTime                   @default(now())

  @@index([purchaseOrderId])
  @@index([receivedById])
  @@map("purchase_order_receipt")
}

model PurchaseOrderReceiptItem {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId           String               @db.Uuid
  receipt             PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String               @db.Uuid
  purchaseOrderItem   PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  quantity            Int

  @@unique([receiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("purchase_order_receipt_item")
}

// ============================================
// STOCK HISTORY
// ============================================

// Why a listing's (or variant's) stock changed. INITIAL is the stock a listing (or a variant added to it) starts with;
// the last four are staff changing it by hand on the listing form, which always says why.
enum StockMovementReason {
  INITIAL
  SALE
  CANCELLATION
  RETURN
  PURCHASE_RECEIVED
  COUNT_CORRECTION
  DAMAGED
  LOST
  OTHER
}

// One change to a listing's stock, or to a variant's on it, written in the same transaction as the change. Together
// they add up to the current stock. The link says what caused it: the order (a sale or a cancellation), the return,
// or the purchase order delivery.
model StockMovement {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeListingId        String               @db.Uuid
  storeListing          StoreListing         @relation(fields: [storeListingId], references: [id], onDelete: Cascade)
  // Null for a product without variants
  storeListingVariantId String?              @db.Uuid
  storeListingVariant   StoreListingVariant? @relation(fields: [storeListingVariantId], references: [id], onDelete: Cascade)
  // +5 in, -2 out
  change                Int
  stockAfter            Int
  reason                StockMovementReason
  // Staff's own words: required for OTHER, optional for the other manual reasons
  note                  String?

  orderId                String?               @db.Uuid
  order                  Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderReturnId          String?               @db.Uuid
  orderReturn            OrderReturn?          @relation(fields: [orderReturnId], references: [id], onDelete: SetNull)
  purchaseOrderReceiptId String?               @db.Uuid
  purchaseOrderReceipt   PurchaseOrderReceipt? @relation(fields: [purchaseOrderReceiptId], references: [id], onDelete: SetNull)

  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([storeListingId, createdAt])
  @@index([storeListingVariantId])
  @@index([orderId])
  @@index([orderReturnId])
  @@index([purchaseOrderReceiptId])
  @@index([createdById])
  @@map("stock_movement")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // One review per customer per product, whichever store sold it: customers never see stores
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String       @db.Uuid
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  // The purchase it's for (only buyers review), and the variant bought, as the order line named it ("4MP / Black")
  orderItemId  String?      @db.Uuid
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  variantLabel String?
  rating       Int
  title        String
  body         String
  // Published at once; staff can hide one, with a reason the customer sees
  status       ReviewStatus @default(PUBLISHED)
  hiddenReason String?
  hiddenAt     DateTime?
  hiddenById   String?      @db.Uuid
  hiddenBy     User?        @relation("ReviewHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([orderItemId])
  @@index([hiddenById])
  @@map("review")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String
  logo           String?
  shippingPolicy String?
  returnsPolicy  String?
  status         OrganizationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  metadata       String?
  members        Member[]
  invitations    Invitation[]
  listings       StoreListing[]
  orderItems     OrderItem[]
  quoteItems     QuoteItem[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitation")
}

// A product a customer has saved for later, with the variant they had picked. Per product, never per store: customers
// never see stores. Saved items stay when a product stops being on sale (it may come back) and go with the product.
model WishListItem {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Cascade, not the optional default SetNull, which would turn a saved variant into the plain product
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  // One row per variant. Postgres treats NULLs as distinct, so products without variants need their own partial index.
  @@unique([userId, productId, variantId])
  @@unique([userId, productId], map: "wish_list_item_no_variant_key", where: { variantId: null })
  @@index([userId, createdAt])
  @@index([productId])
  @@index([variantId])
  @@map("wish_list_item")
}
